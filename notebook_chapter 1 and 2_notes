(x_train, y_train), (x_test, y_test) = cifar10.load_data()

NUM_CLASSES = 10

#add original data before preprocessing
print("Original shapes:", x_train.shape, x_test.shape, y_train.shape, y_test.shape)
print("Original pixel range:", x_train.min(), x_train.max())
