#import the libraries
import numpy as np
from tensorflow.keras.utils import to_categorical
from tensorflow.keras.datasets import cifar10


#loading the cifar 10
(x_train, y_train), (x_test, y_test) = cifar10.load_data()
NUM_CLASSES = 10
print("x_train:", x_train.shape)
print("x_test: ", x_test.shape)
print("y_train:", y_train.shape)
print("y_test: ", y_test.shape)
print("First 10 labels:", y_train[:10].flatten())

#normalise the image pixels with integers from 0 to 255
print("inital step before normalising:", x_train.dtype, x_train.min(), x_train.max())
x_train = x_train.astype("float32") / 255
x_test = x_test.astype("float32") / 255
print("After normalization: ", x_train.dtype, x_train.min(), x_train.max())
print("Example green pixel value, image 54, row 12, column 13:", x_train[54, 12, 13, 1])

#encode labels with a 10 element vector
initial_labels = int (y_train[0,0])

y_train = to_categorical(y_train, NUM_CLASSES)
y_test = to_categorical(y_test, NUM_CLASSES)
print("Original first label:", initial_labels)
print("One-hot first label:", y_train [0])
print("y_train shape:", y_train.shape)
print("y_test shape: ", y_test.shape)

#verifying process
#first check the size of the data set
print("trained set", x_train.shape)
print("test set", x_test.shape)
print("train set labels", y_train.shape)
print("testing labels", y_test.shape)

if len(x_train)==50000:
    print("Training dataset size is correct")
else:
    print("Training dataset size is incorrect")

if len(x_test) == 10000:
    print("Testig dataset size is correct")
else:
    print("Testing dataset size is incorrect")

if y_train.shape[1] == 10:
    print("Training labels are one-hot encoded")
else:
    print("Training labels are not one-hot encoded")

    if y_test.shape[1] == 10:
        print("Testing labels are one-hot encoded")
    else:
        print("Testing labels are not one-hot encoded")

assert np.all((y_train == 0) | (y_train == 1))
assert np.all((y_test == 0) | (y_test == 1))
print("All preprocessing checks passed!")

#printing out the images

import matplotlib.pyplot as plt
class_names = ["airplane", "automobile", "bird", "cat", "deer", "dog", "frog", "horse", "ship", "truck"]
fig, axes = plt.subplots(2, 5, figsize=(12, 5))
for i, ax in enumerate(axes.flat):
    ax.imshow(x_train[i])
    ax.set_title(class_names[np.argmax(y_train[i])])
    ax.axis("off")
plt.tight_layout()
plt.show()
